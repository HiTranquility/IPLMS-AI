# ── AI service — sao chép thành `ai/.env.dev` rồi chỉnh ──────────────────────
# Các biến hạ tầng/secret (đặc biệt AI_DATABASE_URL) phải cấp rõ từ môi trường;
# các biến vận hành còn lại xem mặc định trong app/config/*.

# ── Server ───────────────────────────────────────────────────────────────────
AI_GRPC_PORT=50051
AI_GRPC_MAX_WORKERS=10
# Trần RPC đồng thời; vượt thì RESOURCE_EXHAUSTED (gồm cả stream Copilot đang mở).
AI_GRPC_MAXIMUM_CONCURRENT_RPCS=50
# Phải khớp AI_GRPC_MAX_MESSAGE_MB bên backend (10MB).
AI_GRPC_MAX_MESSAGE_LENGTH=10485760
AI_FASTAPI_PORT=8000
# Origin trình duyệt được gọi REST inference, cách nhau bằng dấu phẩy. Để trống:
# backend gọi server-to-server. [NEVER] đặt "*" (AI không có xác thực).
AI_CORS_ALLOW_ORIGINS=

# ── Vision (ANPR) ────────────────────────────────────────────────────────────
AI_LANE_ID=gate_in_01
AI_YOLO_MODEL_PATH=model/artifacts/bootstrap/anpr/best.pt
AI_YOLO_MODEL_VERSION=bootstrap-v1
# Khi URL có giá trị, service ưu tiên artifact remote thay cho local bootstrap.
# Remote artifact bắt buộc có SHA-256; không commit signed URL vào Git.
AI_YOLO_ARTIFACT_URL=
AI_YOLO_ARTIFACT_SHA256=
AI_OCR_LANGUAGES=en,vi
# Production mặc định warm-up; docker-compose.develop.yml override thành false.
AI_VISION_WARMUP_ON_START=true
AI_DEVICE=cpu
# Rỗng = TẮT tầng phân loại xe (vehicle_type rơi về mặc định).
AI_VEHICLE_CHECKPOINT=
AI_VEHICLE_MODEL_VERSION=v1
AI_VEHICLE_ARTIFACT_URL=
AI_VEHICLE_ARTIFACT_SHA256=
AI_VEHICLE_MODEL=NetV2
AI_VEHICLE_NUM_CLASSES=4
AI_VEHICLE_IMG_SIZE=32
AI_VEHICLE_LABELS=car_sedan,car_suv,motorbike,truck
# Dưới ngưỡng này vehicle_type = rỗng (không rõ) để chống gian lận không so nhầm.
AI_VEHICLE_MIN_CONFIDENCE=0.6
# Đọc biển số từ clip ở AI Console (IPLMS REQ-021 A) — clip không được lưu.
AI_CLIP_MAX_BYTES=52428800
AI_CLIP_MAX_DURATION_S=60
AI_CLIP_MAX_FRAMES=240
AI_CLIP_SAMPLE_INTERVAL_S=0.5
# Chế độ "theo chuyển động": tỉ lệ điểm ảnh đổi tối thiểu (0–1) để giữ một frame.
AI_CLIP_MOTION_THRESHOLD=0.01
AI_CLIP_EVENT_IOU=0.3
AI_CLIP_EVENT_MAX_GAP_S=1.5

# ── Model registry/object storage ───────────────────────────────────────────
AI_MODEL_REGISTRY_CACHE_DIR=var/model-cache
AI_OBJECT_STORAGE_DOWNLOAD_TIMEOUT_SECONDS=120
AI_OBJECT_STORAGE_MAX_ARTIFACT_MB=2048
# Chỉ bật cho MinIO local không TLS; production giữ false.
AI_OBJECT_STORAGE_ALLOW_INSECURE_HTTP=false

# ── Copilot (RAG) ────────────────────────────────────────────────────────────
AI_DB_USER=postgres
AI_DB_PASSWORD=change-me
AI_DB_NAME=iplms_knowledge
# Docker Compose: host `database-vector`; chạy Python native thì đổi thành localhost:5435.
AI_DATABASE_URL=postgresql://postgres:change-me@database-vector:5432/iplms_knowledge
# Dùng chung cho cả embedding lẫn sinh câu trả lời — một tài khoản OpenAI.
AI_LLM_API_KEY=
# Mặc định ollama (local, không cần key). `local` = llama-server; `openai` = gửi câu hỏi ra OpenAI, cần AI_LLM_API_KEY.
AI_LLM_PROVIDER=ollama
AI_OLLAMA_URL=http://127.0.0.1:11434/v1
# ISSUE-011: endpoint tương thích OpenAI khác (ai chạy trong Docker: http://host.docker.internal:11434/v1). Rỗng = AI_OLLAMA_URL khi provider local/ollama.
AI_LLM_BASE_URL=
# Dùng OpenAI thì đặt gpt-5.6-luna.
AI_LLM_MODEL=qwen2.5:0.5b
AI_LLM_TIMEOUT_SECONDS=60
AI_LLM_MAX_RETRIES=2
AI_LLM_MAX_OUTPUT_TOKENS=1200
AI_RAG_TOP_K=5
# Vừa lọc nhánh vector vừa là cổng từ chối (dưới ngưỡng → không gọi LLM). Phụ thuộc
# model embedding: bge-m3 = 0.55; text-embedding-3-small chưa hiệu chỉnh — bảng ở
# app/core/copilot/README.md, đo bằng `python -m app.script.eval_copilot_e2e`.
AI_RAG_MIN_SIMILARITY=0.35

# ── Copilot workflow (LangGraph) ────────────────────────────────────────────
# Phase đầu để false: Q&A RAG hiện tại không phụ thuộc workflow dispute.
AI_WORKFLOW_ENABLED=false
# memory chỉ dùng local/test; production phải dùng postgres.
AI_WORKFLOW_CHECKPOINT_BACKEND=memory
AI_WORKFLOW_CHECKPOINT_DATABASE_URL=
# Tên schema chỉ nhận chữ thường, số và dấu gạch dưới.
AI_WORKFLOW_CHECKPOINT_SCHEMA=ai_workflow
# Chỉ bật một lần bằng role có quyền DDL để tạo bảng checkpoint.
AI_WORKFLOW_CHECKPOINT_SETUP_SCHEMA=false
AI_WORKFLOW_CHECKPOINT_RETENTION_DAYS=30
AI_WORKFLOW_CHECKPOINT_RETENTION_BATCH_SIZE=100

# ── Embedding (nạp liệu tri thức) ────────────────────────────────────────────
AI_EMBEDDING_MODEL=text-embedding-3-small
# Rỗng = OpenAI. Đổi sang model khác = phải nạp lại toàn bộ tài liệu (ISSUE-011 phase 2).
AI_EMBEDDING_BASE_URL=
# [GOTCHA] Phải khớp `vector(N)` của cột knowledge_chunks.embedding. Đổi số này
# mà không migration + embed lại toàn bộ tài liệu thì mọi lượt ghi sẽ hỏng ở
# tầng DB. Xem ngã rẽ A của SUGGESTION-008.
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=64
AI_EMBEDDING_TIMEOUT_SECONDS=30
AI_EMBEDDING_MAX_RETRIES=3
# Postgres không có pgvector → chỉ dev mới được bật (cột DOUBLE PRECISION[], quét
# toàn bảng). Mặc định false: thiếu pgvector thì dừng với lỗi rõ (ai ADR-0001).
AI_EMBEDDING_ALLOW_NO_PGVECTOR=false

# ── Forecast ─────────────────────────────────────────────────────────────────
AI_DATALAKE_S3_BUCKET=iplms-datalake
AI_DATALAKE_LOCAL_PATH=data/datalake
# PostgreSQL nghiệp vụ của backend, KHÔNG phải pgvector AI_DATABASE_URL.
# Docker: dùng host.docker.internal:5433; Python native: dùng localhost:5433.
AI_DATALAKE_SOURCE_DATABASE_URL=postgresql://postgres:change-me@host.docker.internal:5433/iplms
# AI Console nội bộ (ADR-0048): database RIÊNG `ai_console`, user riêng — không dùng
# chung tài khoản với AI_DATABASE_URL. Docker: host `database-vector`; Python native: localhost:5435.
AI_CONSOLE_DATABASE_URL=postgresql://ai_console:change-me@database-vector:5432/ai_console
# Mật khẩu user `ai_console`; script docker/database-vector/init chỉ tạo DB khi volume database-vector mới.
AI_CONSOLE_DB_PASSWORD=change-me
# User siết quyền ai_inference cho process inference (ADR-0051): chỉ bảng A2 và đọc accept_policy.
# AI_CONSOLE_INFERENCE_DATABASE_URL=postgresql://ai_inference:change-me@database-vector:5432/ai_console
AI_INFERENCE_DB_PASSWORD=change-me
# OAuth client "Web application" trên Google Cloud Console; redirect URI phải khớp.
AI_CONSOLE_GOOGLE_CLIENT_ID=
AI_CONSOLE_GOOGLE_CLIENT_SECRET=
AI_CONSOLE_GOOGLE_REDIRECT_URI=http://localhost:8090/api/auth/google/callback
# Khoá Fernet mã hoá secret TOTP — sinh bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONSOLE_TOTP_ENCRYPTION_KEY=
# Kênh A2: process gRPC (inference) ghi mẫu backend đẩy sang vào AI_CONSOLE_DATABASE_URL.
# Ảnh cắt chưa ai gán nhãn ở console bị xoá sau N ngày.
AI_CONSOLE_VISION_RETENTION_DAYS=90
# Nút "nạp mẫu thực hành" ở Vision Lab (ghi mẫu train giả) — chỉ bật ở dev/sandbox.
AI_CONSOLE_DEMO_SEED_ENABLED=false
# Models & Connections (ADR-0061 §7): host được làm endpoint connection, phân cách dấu phẩy.
# Rỗng = chặn hết. Link-local/metadata (169.254.0.0/16, fe80::/10) luôn bị chặn.
AI_CONSOLE_MODEL_CONNECTION_HOSTS=host.docker.internal,127.0.0.1,localhost
# Tên biến env chứa key ngoài tiền tố AI_LLM_KEY_ (chỉ TÊN, không phải giá trị).
AI_CONSOLE_MODEL_SECRET_NAMES=
AI_CONSOLE_MODEL_TEST_TIMEOUT_SECONDS=10
AI_CONSOLE_MODEL_TESTS_PER_MINUTE=10
# Reloader theo dõi file cho console (chỉ máy dev).
AI_CONSOLE_RELOAD=false
# File cấu hình đổi ở trang Settings; mặc định ai/var/runtime_settings.json.
# Đọc từ biến môi trường thật của process, KHÔNG đọc từ .env.dev.
# AI_RUNTIME_SETTINGS_PATH=

# ── Telemetry mỗi request AI (IPLMS ADR-0049; đề Final §4.2/§6.6) ────────────
# Lưu bảng ai_request_log trong AI_DATABASE_URL. Câu hỏi/trả lời được che PII.
AI_TELEMETRY_ENABLED=true
# Khoá HMAC để băm user id; trống = không lưu user và không nhận 👍/👎.
AI_TELEMETRY_HMAC_KEY=
AI_TELEMETRY_RETENTION_DAYS=30
# Giá USD / 1 triệu token của model đang dùng; để trống thì dashboard hiện "—".
AI_TELEMETRY_PRICE_INPUT_PER_MTOK=
AI_TELEMETRY_PRICE_OUTPUT_PER_MTOK=

# ── Logging ──────────────────────────────────────────────────────────────────
AI_LOG_LEVEL=INFO

# ── Docker Compose (cổng host, mạng, image) — bỏ trống thì dùng mặc định bên phải ─
# Mạng chung với backend; stack backend tạo, chạy riêng AI thì: docker network create iplms-shared-dev
# SHARED_NETWORK=iplms-shared-dev
# COMPOSE_PROJECT_NAME=iplms-ai-dev
# AI_IMAGE=iplms-ai:latest
# PRELOAD_EASYOCR_MODELS=true
# Cổng bind 127.0.0.1 của gateway Traefik và pgvector.
# AI_GATEWAY_REST_PORT=8000
# AI_GATEWAY_GRPC_PORT=50051
# AI_GATEWAY_DASHBOARD_PORT=8080
# AI_DB_HOST_PORT=5435
# Giới hạn tải REST ở Traefik (bug-046): request đồng thời, tốc độ trung bình/giây, burst.
# AI_GATEWAY_REST_INFLIGHT=20
# AI_GATEWAY_REST_RATE_AVG=30
# AI_GATEWAY_REST_RATE_BURST=60

# ── Tuỳ chọn nâng cao — mặc định nằm trong app/config/*, chỉ bỏ comment khi cần đổi ─
# Server
# AI_GRPC_BIND_HOST=[::]
# AI_DEVELOPER_DASHBOARD_ENABLED=false
# Vision
# AI_ONNX_ENABLED=true
# AI_ONNX_MODEL_DIR=data/models
# AI_OCR_MODEL_STORAGE_DIR=
# LLM chạy bằng llama-server (provider "local", ai ADR-0004 — VRAM 4 GB)
# AI_LOCAL_LLM_URL=http://127.0.0.1:8005/v1
# AI_LOCAL_LLM_BINARY_PATH=var/bin/llama/llama-server.exe
# AI_LOCAL_LLM_MODEL_PATH=model/checkpoint/llm/Qwen3.5-4B-Q4_K_M.gguf
# AI_LOCAL_LLM_HOST=127.0.0.1
# AI_LOCAL_LLM_PORT=8005
# AI_LOCAL_LLM_GPU_LAYERS=33
# AI_LOCAL_LLM_CTX_SIZE=4096
# AI_LOCAL_LLM_PARALLEL_SLOTS=1
# AI_LOCAL_LLM_THREADS=4
# Đánh giá tri thức (knowledge_eval) — cổng xuất bản tài liệu
# AI_EVAL_MIN_CASES=5
# AI_EVAL_MIN_PASS_RATIO=0.9
# AI_EVAL_MAX_CASES_PER_RUN=30
# AI_EVAL_MAX_GENERATED_CASES=20
# AI_EVAL_MAX_CONCURRENT_RUNS=3
# AI_EVAL_STALE_AFTER_SECONDS=180
# AI_EVAL_JUDGE_ENABLED=true
# AI_EVAL_JUDGE_MODEL=
# AI Console (phiên đăng nhập)
# AI_CONSOLE_BIND_HOST=127.0.0.1
# AI_CONSOLE_PORT=8090
# AI_CONSOLE_TOTP_ISSUER=IPLMS AI Console
# AI_CONSOLE_SESSION_TTL_HOURS=8
# AI_CONSOLE_IDLE_TIMEOUT_MINUTES=30
# AI_CONSOLE_STEP_UP_MINUTES=5
# Bật true khi Console chạy sau HTTPS.
# AI_CONSOLE_COOKIE_SECURE=false
# Datalake / Forecast
# AI_DATALAKE_EXPORT_BATCH_SIZE=1000
# AI_DATALAKE_OCCUPANCY_SLOT_MINUTES=30
# Logging
# AI_LOG_NAME=IPLMS_AI
# AI_LOG_FORMAT=[%(asctime)s] [%(levelname)s] [%(name)s]: %(message)s
# AI_LOG_DATEFMT=%Y-%m-%d %H:%M:%S
